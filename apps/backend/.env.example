# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3001

# ============================================
# DATABASE (MongoDB Atlas for Production)
# ============================================
# Development: mongodb://localhost:27017/unique-brew-cafe
# Production: Get from MongoDB Atlas (https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/unique-brew-cafe?retryWrites=true&w=majority

# Connection Pool (Optimized for 512MB Render Free Tier)
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# FRONTEND CONFIGURATION (Update for production)
# ============================================
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ORIGIN=http://localhost:5173

# ============================================
# CLOUDINARY (Image Upload)
# ============================================
CLOUDINARY_CLOUD_NAME=Unique_Brew
CLOUDINARY_API_KEY=161177217641536
CLOUDINARY_API_SECRET=e_WremLrh_-i7kNJuEgpXyDhIo8

# ============================================
# EMAIL SERVICE (Brevo - Optional)
# ============================================
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME="Unique Brew Cafe"
BREVO_PARTNER_KEY=

# ============================================
# RATE LIMITING (Production Security)
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# ADMIN SEEDING (Development Only)
# ============================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456